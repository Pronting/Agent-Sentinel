APP_NAME=Agent Sentinel
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=dev
LOG_LEVEL=INFO

OPENAI_API_KEY=your-openai-api-key
CODEX_BASE_URL=
CODEX_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0
OPENAI_HTTP_TRUST_ENV=false

FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
FEISHU_SECRET=
FEISHU_ALERT_ENABLED=true
FEISHU_ALERT_TITLE_PREFIX=Agent Sentinel

ALERT_API_TOKEN=replace-with-a-strong-token
ALERT_DEDUP_WINDOW_SECONDS=60
ALERT_STORE_LIMIT=100
